{
  "项目名称": "运动员网络权益保护",
  "参与角色": [
    "当事人代理",
    "俱乐部保护专员",
    "俱乐部值班主管",
    "平台联络员",
    "法务复核员"
  ],
  "参考状态": [
    "已受理",
    "保护中",
    "待复核",
    "申诉中",
    "已移交",
    "已关闭"
  ],
  "严重度": [
    {
      "等级": "普通批评",
      "编码": "criticism",
      "说明": "针对赛场表现、竞技状态的负面评价，不构成网络暴力，仅登记观察、不立为保护事件",
      "可立案": false,
      "自动升级": false
    },
    {
      "等级": "一般网暴",
      "编码": "abuse",
      "说明": "辱骂、骚扰、恶意诋毁等网络暴力言论，可立为事件常规处置",
      "可立案": true,
      "自动升级": false
    },
    {
      "等级": "直接人身威胁",
      "编码": "direct_threat",
      "说明": "含人身伤害、死亡威胁或对住所、行踪的现实威胁，必须按值班规则立即升级",
      "可立案": true,
      "自动升级": true
    }
  ],
  "授权范围": [
    {
      "编码": "report",
      "名称": "受理登记",
      "说明": "允许提交线索、登记受控证据引用"
    },
    {
      "编码": "platform_complaint",
      "名称": "平台投诉",
      "说明": "允许以当事人名义向平台发起投诉"
    },
    {
      "编码": "police_report",
      "名称": "报案",
      "说明": "允许向公安机关移交材料"
    },
    {
      "编码": "public_statement",
      "名称": "公开澄清",
      "说明": "允许以当事人名义对外发布澄清"
    },
    {
      "编码": "evidence_storage",
      "名称": "证据留存",
      "说明": "允许继续留存本案受控证据引用与内容哈希"
    }
  ],
  "授权规则": {
    "默认范围": ["report", "evidence_storage"],
    "撤回规则": "当事人可随时撤回任一非核心授权；撤回只影响尚未完成的动作，已完成动作与既有责任链记录保留；evidence_storage 在申诉或司法程序存续期间不可单独撤回",
    "动作所需授权": {
      "platform_complaint": ["platform_complaint"],
      "police_report": ["police_report"],
      "public_statement": ["public_statement"]
    }
  },
  "处置动作": [
    {
      "类型": "platform_complaint",
      "名称": "平台投诉",
      "复核角色": "平台联络员",
      "说明": "向内容所在平台提交投诉，要求删除或处置侵权内容"
    },
    {
      "类型": "police_report",
      "名称": "报案",
      "复核角色": "法务复核员",
      "说明": "向公安机关移交证据材料、报告违法线索"
    },
    {
      "类型": "public_statement",
      "名称": "公开澄清",
      "复核角色": "法务复核员",
      "说明": "以俱乐部或当事人名义对外发布澄清声明"
    },
    {
      "类型": "platform_followup",
      "名称": "平台跟进",
      "复核角色": "平台联络员",
      "说明": "跟进已提交投诉的处理进度，无独立授权要求"
    },
    {
      "类型": "protection_plan",
      "名称": "保护方案",
      "复核角色": "俱乐部保护专员",
      "说明": "心理支持、赛程安保、评论区管理等内部保护安排"
    }
  ],
  "职责分离": {
    "说明": "报案、平台投诉、公开澄清必须由对应复核角色复核后方可执行；事件提交人不能自行复核自己提交的动作",
    "提交角色": ["当事人代理", "俱乐部保护专员"],
    "禁止自复核": true
  },
  "值班规则": {
    "触发等级": ["direct_threat"],
    "升级动作": "duty_escalation",
    "通知角色": ["俱乐部值班主管", "俱乐部保护专员"],
    "时限分钟": 30,
    "重复抑制": "同一事件在同一值班周期内只升级、通知一次；等级再次确认只刷新最近确认时间，不产生第二案件或第二次通知"
  },
  "平台": [
    {
      "编码": "weibo",
      "名称": "微博",
      "回执字段": ["receipt_id", "status", "reported_at"]
    },
    {
      "编码": "douyin",
      "名称": "抖音",
      "回执字段": ["receipt_id", "status", "reported_at"]
    },
    {
      "编码": "wechat",
      "名称": "微信",
      "回执字段": ["receipt_id", "status", "reported_at"]
    }
  ],
  "聚类": {
    "策略": "对受侵害当事人相同且内容哈希一致、或平台账号相同的线索给出合并建议；系统只产生建议，由俱乐部保护专员人工确认后才合并",
    "键": ["victim_code+content_sha256", "linked_account_key"]
  },
  "回调幂等": {
    "说明": "平台或证据采集回调以 callback_id 去重：同一 callback_id 只处理一次；回执状态更新到既有事件，不重复通知、不产生第二案件",
    "重复响应": "返回首次处理结果，并标注 duplicate=true"
  },
  "误报申诉": {
    "说明": "事件被标记误报或当事人申诉期间，事件置为申诉中，敏感材料仅对法务复核员与俱乐部值班主管可见，并阻断新的对外动作",
    "敏感脱敏": ["content_ref", "raw_excerpt", "linked_accounts"],
    "可见角色例外": ["法务复核员", "俱乐部值班主管"]
  },
  "责任链": {
    "说明": "内容删除、账号改名、证据补充、授权撤回均只追加变更记录，不覆盖、不删除既有证据与决定；任意时刻可还原事件全过程"
  },
